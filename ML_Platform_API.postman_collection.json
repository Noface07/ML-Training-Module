						"url": {
							"raw": "{{base_url}}/v1/hparams/risk_scoring",
							"host": ["{{base_url}}"],
							"path": ["v1", "hparams", "risk_scoring"]
						},
						"description": "Get default hyperparameters for risk scoring. Note: different defaults from failure_prediction (min_child_weight=1, scale_pos_weight=1.0)."
					},
					"response": []
